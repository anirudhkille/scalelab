    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "immer": "^11.2.10",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "recharts": "^3.11.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
